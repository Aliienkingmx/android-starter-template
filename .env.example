# Copia este archivo a `.env` y rellena tus valores.
# Nunca subas `.env` al repositorio (está en .gitignore).
#
# Patrón para API keys que tu app necesite (Firebase, Gemini, etc.).
# El plugin Gradle Secrets de Google (com.google.android.libraries.mapsplatform.secrets-gradle-plugin)
# puede exponerlas como BuildConfig.* en modo debug.
#
# GOOGLE_API_KEY=tu_clave_aqui
